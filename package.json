{
  "name": "react-native-mapsforge-vtm",
  "version": "0.7.0",
  "description": "React Native components to build vector maps using Mapsforges fork of vtm. Offline rendering of OpenStreetMap data. Android only",
  "source": "./src/index.tsx",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./reanimated": {
      "types": "./lib/typescript/src/reanimated/index.d.ts",
      "default": "./lib/module/reanimated/index.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-mapsforge-vtm-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build lib",
    "prepare": "bob build",
    "format": "prettier . --write",
    "release": "bash ./scripts/publish.sh"
  },
  "keywords": [
    "react-native",
    "android",
    "maps",
    "offline",
    "mapsforge",
    "vector",
    "mbtiles",
    "hillshading",
    "map"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhotadhari/react-native-mapsforge-vtm.git"
  },
  "author": "jhotadhari <tellme@waterproof-webdesign.de> (https://github.com/jhotadhari)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jhotadhari/react-native-mapsforge-vtm/issues"
  },
  "homepage": "https://github.com/jhotadhari/react-native-mapsforge-vtm#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^2.1.9",
    "@react-native-community/cli": "20.1.3",
    "@react-native/eslint-config": "^0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.5",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.17",
    "del-cli": "^7.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "keep-a-changelog": "^2.5.3",
    "prettier": "^3.8.4",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-multiline-arrays": "^4.1.9",
    "react": "19.2.7",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-worklets": ">=0.1.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-worklets": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNMapsforgeVtmViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.jhotadhari.reactnative.mapsforge.vtm"
    },
    "ios": {
      "componentProvider": {
        "MapsforgeVtmView": "MapsforgeVtmView"
      }
    },
    "includesGeneratedCode": true
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "fabric-view",
    "version": "0.49.8"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  }
}
